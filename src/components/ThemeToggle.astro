---
/*
  Theme toggle: switches between light and dark by setting data-theme on <html>
  and saving the choice in localStorage as { theme, os }. BaseLayout restores it
  before the first paint and drops it as soon as the OS theme changes.
  Switching back to the OS theme clears the choice, so the site follows the OS
  again. The parent decides the position through `class`.
*/
import Button from './ui/Button.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Button variant="secondary" size="sm" class={className} data-theme-toggle>
  <!-- Shown in light mode: offers dark -->
  <span class="inline-flex items-center gap-2 dark:hidden">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
    </svg>
    <span>
      <span class="sr-only">Switch to </span>Dark<span class="sr-only"> theme</span>
    </span>
  </span>

  <!-- Shown in dark mode: offers light -->
  <span class="hidden items-center gap-2 dark:inline-flex">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </svg>
    <span>
      <span class="sr-only">Switch to </span>Light<span class="sr-only"> theme</span>
    </span>
  </span>
</Button>

<script>
  const root = document.documentElement;
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function toggleTheme() {
    const os = prefersDark.matches ? 'dark' : 'light';
    // Current theme: the visitor's choice, or the OS theme if none
    const current = root.dataset.theme ?? os;
    const next = current === 'dark' ? 'light' : 'dark';

    if (next === os) {
      // Back to the OS theme: drop the choice so the site follows the OS again
      root.removeAttribute('data-theme');
    } else {
      root.dataset.theme = next;
    }

    try {
      if (next === os) {
        localStorage.removeItem('theme');
      } else {
        localStorage.setItem('theme', JSON.stringify({ theme: next, os }));
      }
    } catch {
      // Storage blocked (e.g. some private modes): the theme still switches
    }
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      // Crossfade between themes where the View Transitions API is available
      if ('startViewTransition' in document && !reducedMotion.matches) {
        document.startViewTransition(toggleTheme);
      } else {
        toggleTheme();
      }
    });
  });
</script>
