---
/*
  Contact card for the home "Contact" section ("Work with me?", "Hire me?").
  Image (or placeholder) with the title pinned to the bottom; the whole card is
  a link. Hover darkens the border, like the secondary button. Cards never
  have shadows.
*/
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
  /* The title already names the link, so the image is decorative by default */
  imageAlt?: string;
  class?: string;
}

const { href, title, image, imageAlt = '', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group relative block aspect-video overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-200 hover:border-muted',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
    className,
  ]}
>
  {image ? (
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 1000, 1400]}
      sizes="(min-width: 640px) 50vw, 100vw"
      class="absolute inset-0 size-full object-cover"
    />
  ) : (
    <span class="absolute inset-0 flex items-center justify-center text-sm text-muted">
      Image placeholder
    </span>
  )}

  <div
    class:list={[
      'absolute inset-x-0 bottom-0 flex items-center gap-3 px-8 py-6',
      // Keeps the title legible on top of a real image
      image && 'bg-linear-to-t from-surface via-surface/80 to-transparent pt-12',
    ]}
  >
    <span class="block size-4.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
    <h3 class="text-2xl font-bold">{title}</h3>
  </div>
</a>
