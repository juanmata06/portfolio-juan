---
/*
  Project card for the home "Experience" grid. Shows the project image; on
  hover (or keyboard focus) the image fades out and the title and summary
  fade in, and the border darkens like the other clickable elements. The whole
  card links to the project's detail page.
  Without `image` it renders the placeholder. Cards never have shadows.
*/
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  /* The title and summary already name the link, so the image is decorative by default */
  imageAlt?: string;
  class?: string;
}

const { href, title, description, image, imageAlt = '', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group relative block aspect-16/10 overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-200 hover:border-muted',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
    className,
  ]}
>
  <!-- Image (or placeholder): visible at rest -->
  <div class="absolute inset-0 transition-opacity duration-300 group-hover:opacity-0 group-focus-visible:opacity-0">
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        class="size-full object-cover"
      />
    ) : (
      <span class="flex size-full items-center justify-center text-sm text-muted">
        Image placeholder
      </span>
    )}
  </div>

  <!-- Text: revealed on hover / focus -->
  <div class="absolute inset-0 flex flex-col justify-end gap-2 p-6 text-left opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
    <span class="block size-4.5 rounded-full bg-accent" aria-hidden="true"></span>
    <h3 class="text-lg font-bold">{title}</h3>
    <p class="text-muted">{description}</p>
  </div>
</a>
