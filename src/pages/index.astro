---
/*
  SAMPLE CONTENT to test the light/dark theme and the design tokens.
  Replace it with the real home.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ContactCard from '../components/home/ContactCard.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import PointGrid from '../components/detail/PointGrid.astro';
import PointList from '../components/detail/PointList.astro';

const projects = [
  {
    title: 'Lorem ipsum',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
  {
    title: 'Dolor sit amet',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
  {
    title: 'Consectetur elit',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
];

const points = [
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat, duis aute irure dolor in reprehenderit.',
  'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia.',
];

const keys = [
  {
    title: 'Lorem ipsum',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
  {
    title: 'Dolor sit amet',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
  {
    title: 'Consectetur elit',
    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.',
  },
];

const swatches = [
  { name: 'canvas', use: 'Page background', class: 'bg-canvas' },
  { name: 'surface', use: 'Cards, pills', class: 'bg-surface' },
  { name: 'line', use: 'Borders, dividers', class: 'bg-line' },
  { name: 'ink', use: 'Primary text', class: 'bg-ink' },
  { name: 'muted', use: 'Secondary text', class: 'bg-muted' },
  { name: 'accent', use: 'Brand, links', class: 'bg-accent' },
  { name: 'on-accent', use: 'Text on accent', class: 'bg-on-accent' },
];
---

<BaseLayout title="Juan — Product Manager">
  <ThemeToggle class="fixed top-5 right-5 z-50" />

  <main class="mx-auto max-w-5xl px-6 py-24">
    <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">Hi, I'm Juan.</h1>
    <p class="mt-6 text-2xl leading-snug font-medium">
      Product Manager y consultor en tecnología y soluciones digitales.
    </p>
    <p class="mt-4 max-w-prose leading-relaxed text-muted">
      Sample content to test the theme. The page follows your system theme. The button in the top
      right corner overrides it and is remembered across pages and reloads, until you change your
      system theme again.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/preview/home">Home preview</Button>
      <Button href="/preview/detail" variant="secondary">
        Detail preview
      </Button>
    </div>

    <h2 class="mt-16 text-2xl font-bold">Buttons</h2>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Button>Primary</Button>
      <Button variant="secondary">Secondary</Button>
      <Button size="sm">Primary sm</Button>
      <Button variant="secondary" size="sm">
        Secondary sm
      </Button>
      <Button disabled>Disabled</Button>
    </div>

    <h2 class="mt-16 text-2xl font-bold">Badges</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      <Badge>Freelance</Badge>
      <Badge>5 months</Badge>
      <Badge>Role: Product Manager</Badge>
    </div>

    <article class="mt-16 rounded-2xl border border-line bg-surface p-8">
      <h2 class="text-2xl font-bold">A card on the surface color</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Secondary text on a card, with an{' '}
        <a href="#" class="text-accent underline underline-offset-4 hover:no-underline">
          inline link
        </a>{' '}
        in the accent color.
      </p>
    </article>

    <h2 class="mt-16 text-2xl font-bold">Project cards</h2>
    <p class="mt-2 text-muted">Hover or focus a card to reveal its text.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          href="/preview/detail"
          title={project.title}
          description={project.description}
        />
      ))}
    </div>

    <h2 class="mt-16 text-2xl font-bold">Contact cards</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <ContactCard href="#" title="Work with me?" />
      <ContactCard href="#" title="Hire me?" />
    </div>

    <h2 class="mt-16 text-2xl font-bold">Point list</h2>
    <p class="mt-2 text-muted">Detail page: "Challenges" and "Final result" sections.</p>
    <PointList items={points} class="mt-6" />

    <h2 class="mt-16 text-2xl font-bold">Point grid</h2>
    <p class="mt-2 text-muted">
      Detail page: "Keys" section. With an odd count the last cell spans both columns.
    </p>
    <PointGrid items={keys} class="mt-6" />

    <h2 class="mt-16 text-2xl font-bold">Color tokens</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {swatches.map((swatch) => (
        <li>
          <span class:list={['block h-16 rounded-xl border border-line', swatch.class]} />
          <span class="mt-2 block text-sm font-semibold">{swatch.name}</span>
          <span class="block text-sm text-muted">{swatch.use}</span>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
